<div class="container">
    <div class="login-container mt-5">
        <h2><i class="fas fa-key"></i> Login (JWT)</h2>
        <form action="/Account/login" method="POST">
            <div class="input-group">
                <i class="fas fa-user"></i>
                <input type="text" name="EmailAddress" placeholder="Enter Username" required>
            </div>
            <div class="input-group">
                <i class="fas fa-lock"></i>
                <input type="password" name="Password" placeholder="Enter Password" required>
            </div>
            <button type="submit" class="login-btn">Login</button>
            <a href="#" class="forgot-password">Forgot Password?</a>
            <span>* Default user name is santosh and password is pass123</span>
        </form>
    </div>

    <div class="login-container1 mt-3">
        <a href="/account/LoginWithThirdParty" class="btn btn-info">
            <i class="fas fa-key"></i> Login With Google, GitHub & More
        </a>
    </div>
</div>


<script>
        document.querySelector("form").addEventListener("submit", function (event) {
    event.preventDefault();
    if (window.location.href.toLowerCase().includes("account/login")) {
        const formData = new FormData(event.target);
        const json = JSON.stringify(Object.fromEntries(formData));

        fetch("/Account/login", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: json
        })
            .then(response => response.json())
            .then(data => alert(data))
            .catch(error => alert(error));
    }


    });
</script>