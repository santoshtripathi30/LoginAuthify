@model ProviderSettingsVM

<div class="container mt-4">
    <h2 class="mb-4">Manage Authentication Providers</h2>

    <form method="post" action="/LoginProvider/update">
        <div class="row">
            @foreach (var provider in Model.AvailableProviders)
            {
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="enabledProviders" value="@provider"
                               id="provider-@provider" @(Model.EnabledProviders.Contains(provider) ? "checked" : "")>
                        <label class="form-check-label" for="provider-@provider">
                            @provider
                        </label>
                    </div>
                </div>
            }
        </div>
        <button type="submit" class="btn btn-primary mt-3">Save Changes</button>
    </form>
</div>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
